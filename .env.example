# ============================================================
#  Ksuzy AI assistant — переменные окружения
#  Скопируй этот файл в .env и заполни своими значениями.
#  .env НИКОГДА не коммить в публичный репозиторий.
# ============================================================

# --- Telegram ---
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user id разработчика — только он может писать "Ксай обновись"
# Узнать свой id можно у @userinfobot
DEVELOPER_ID=

# --- Gemini API ---
# Можно задать до N ключей: GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# Бот будет перебирать их по кругу и ставить на кулдаун при 429/403.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Альтернативно можно задать один ключ через GEMINI_API_KEY=
GEMINI_API_KEY=

# --- Автообновление ---
# Репозиторий и ветка, из которых тянем обновления по команде "Ксай обновись"
REPO_URL=https://github.com/starfall-apk/Ksuzy-AI-assistant-by-N3
REPO_BRANCH=main
# Абсолютный путь к локальной копии репозитория.
# Если не задан — используется текущая рабочая директория.
REPO_PATH=
# Таймаут git pull в секундах
GIT_PULL_TIMEOUT=60

# --- Личность бота (можно менять без правки кода) ---
ASSISTANT_NAME=Ksuzy
ASSISTANT_ALT_NAME=Ксай
AUTHOR_NAME=n³
AUTHOR_HANDLE=@ljjEU

# --- Модели ---
DEFAULT_MODEL=gemini-3.5-flash-lite
DEFAULT_LENGTH=normal
